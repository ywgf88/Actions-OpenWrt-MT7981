#
# OpenWrt v25.12.2 — CMCC RAX3000M & Qihoo 360T7 & Cetron CT3003
# Target: MediaTek Filogic (MT7981B)
# Features: IPv4-only / Vantage theme / PassWall2 / SQM / DDNS / WOL / nlbwmon / UPnP / WireGuard
# 其余选项由 make defconfig 自动补全
#
# ==== Target: MediaTek Filogic — 多设备同时编译 ====
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cmcc_rax3000m=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_qihoo_360t7=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_cetron_ct3003=y
# ==== failsafe 预启动网络：与默认 LAN 保持一致 ====
CONFIG_TARGET_PREINIT_IP="192.168.6.1"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.6.255"
# ==== 版本信息 ====
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="OpenWrt"
CONFIG_VERSION_NUMBER="25.12.2"
CONFIG_VERSION_CODE="25.12.2"
CONFIG_VERSION_REPO="https://downloads.openwrt.org/releases/25.12.2"
# ==== LuCI 基础 ====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_LUCI_LANG_zh_Hans=y
# ==== 默认主题：Vantage ====
CONFIG_PACKAGE_luci-theme-vantage=y
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
# ==== PassWall2（仅 Xray 核心 + nftables 透明代理）====
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin is not set
# ==== IPv4 单栈：去掉 IPv6 相关组件 ====
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_luci-proto-ipv6 is not set
# CONFIG_PACKAGE_ipv6helper is not set
# CONFIG_PACKAGE_6in4 is not set
# CONFIG_PACKAGE_6to4 is not set
# ==== 体积精简 ====
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-app-vantage is not set
# ==== 家庭场景插件（仅选 luci-app，依赖由 make defconfig 自动补齐）====
# 限速排队：防止单个设备把上行/下行占满
CONFIG_PACKAGE_luci-app-sqm=y
# 动态域名：宽带无固定公网 IP 时远程回家的前提
CONFIG_PACKAGE_luci-app-ddns=y
# 网络唤醒：远程开 NAS / 台式机
CONFIG_PACKAGE_luci-app-wol=y
# 按设备统计流量，查谁在偷带宽
CONFIG_PACKAGE_luci-app-nlbwmon=y
# UPnP / NAT-PMP 端口自动映射，BT 与联机游戏用
CONFIG_PACKAGE_luci-app-upnp=y
# WireGuard 远程回家（内核态，比 tailscale 轻且快）
CONFIG_PACKAGE_luci-proto-wireguard=y
# 网页里执行命令，调试用
CONFIG_PACKAGE_luci-app-commands=y
# ==== 上述插件的中文语言包 ====
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wireguard-zh-cn=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y
